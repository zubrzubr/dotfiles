[include]
    path = ~/.gitconfig.local

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    syntax-theme = gruvbox-dark

[init]
    defaultBranch = main

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[fetch]
    prune = true

[rerere]
    enabled = true